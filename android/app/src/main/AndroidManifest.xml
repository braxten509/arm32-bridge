<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Reads game APKs in Downloads and wherever the user adds them from; the user turns on
         "All files access" in the setup screen. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Installs games through Android's installer (the user turns on "Install unknown
         apps", which also opens Android/obb for game data), updates them without asking again, and
         removes them. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Sees which converted games are installed, to offer Open. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Game Bridge"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Opens an iPhone game for the game's own app (IphoneApps.kt, OpenIphoneGame.kt):
             only a game folder on shared storage, then the private game screen below. -->
        <activity
            android:name=".OpenIphoneGame"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- iPhone games (64-bit): own process and task, landscape, full screen. Opened by
             Game Bridge itself (a game's card or its home-screen icon) with the unpacked game
             folder in the "app" extra; opening it again goes back to the running game. Not exported:
             it runs the folder's program as this app, so other apps must not choose it. -->
        <activity
            android:name=".IosGameActivity"
            android:exported="false"
            android:process=":ios"
            android:launchMode="singleTask"
            android:taskAffinity="dev.braxten.gamebridge.ios"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
